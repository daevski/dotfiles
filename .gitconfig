[user]
    name = David McKee
    email = git-author.n4t20@simplelogin.com
[core]
	editor = vim
	autocrlf = input
	excludesfile = /home/david/.gitignore_global

[includeIf "gitdir:~/code/ebscois/"]
    path = ~/.gitconfig-ebscois
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[safe]
	directory = *
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
